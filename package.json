{
  "name": "dream-logic",
  "version": "1.0.0",
  "description": "A surreal natural-language puzzle game powered by Google Gemini AI.",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend"
  },
  "keywords": [
    "dream-logic",
    "puzzle",
    "interactive-fiction",
    "ai",
    "gemini",
    "natural-language"
  ],
  "author": "Samarth",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
